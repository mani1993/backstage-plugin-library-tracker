{
  "name": "backstage-plugin-library-tracker-common",
  "description": "Shared types and DTOs for the library-tracker Backstage plugin",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "dependency-management",
    "developer-portal"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "common-library",
    "pluginId": "library-tracker",
    "pluginPackages": [
      "backstage-plugin-library-tracker",
