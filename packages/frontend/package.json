{
  "name": "backstage-plugin-library-tracker",
  "description": "Frontend for the library-tracker Backstage plugin: org-wide dependency visibility",
  "version": "0.1.1",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "backstage",
    "backstage-plugin",
    "dependency-management",
    "dependencies",
    "developer-portal",
    "software-catalog"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "library-tracker",
    "pluginPackages": [
      "backstage-plugin-library-tracker",
      "backstage-plugin-library-tracker-backend",
      "backstage-plugin-library-tracker-common"
    ]
  },
  "sideEffects": false,
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/catalog-model": "^1.9.0",
    "@backstage/core-components": "^0.18.10",
    "@backstage/core-plugin-api": "^1.12.6",
    "@backstage/errors": "^1.3.1",
    "@backstage/plugin-catalog-react": "^3.0.0",
    "@backstage/theme": "^0.7.3",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "4.0.0-alpha.61",
    "backstage-plugin-library-tracker-common": "^0.1.0",
    "react-use": "^17.5.1"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.2",
    "@backstage/dev-utils": "^1.1.23",
    "@backstage/test-utils": "^1.7.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.0",
    "msw": "^1.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "files": [
    "dist"
  ]
}
