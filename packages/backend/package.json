{
  "name": "backstage-plugin-library-tracker-backend",
  "description": "Backend for the library-tracker Backstage plugin: scans component repos for dependencies",
  "version": "0.1.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.cjs.js",
    "types": "dist/index.d.ts"
  },
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "library-tracker",
    "pluginPackages": [
      "backstage-plugin-library-tracker",
      "backstage-plugin-library-tracker-backend",
      "backstage-plugin-library-tracker-common"
    ]
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.1",
    "@backstage/catalog-client": "^1.15.2",
    "@backstage/catalog-model": "^1.9.0",
    "@backstage/config": "^1.3.8",
    "@backstage/errors": "^1.3.1",
    "@backstage/integration": "^2.0.2",
    "@backstage/plugin-catalog-node": "^2.2.1",
    "@backstage/types": "^1.2.2",
    "@iarna/toml": "^2.2.5",
    "backstage-plugin-library-tracker-common": "^0.1.0",
    "express": "^4.21.2",
    "express-promise-router": "^4.1.1",
    "fast-xml-parser": "^4.5.0",
    "knex": "^3.1.0",
    "semver": "^7.6.3",
    "yn": "^5.0.0"
  },
  "devDependencies": {
    "@backstage/backend-defaults": "^0.17.2",
    "@backstage/backend-test-utils": "^1.11.3",
    "@backstage/cli": "^0.36.2",
    "@types/express": "^4.17.21",
    "@types/semver": "^7.5.8",
    "@types/supertest": "^6.0.2",
    "better-sqlite3": "^11.5.0",
    "supertest": "^7.0.0"
  },
  "files": [
    "dist",
    "config.d.ts",
    "migrations"
  ],
  "configSchema": "config.d.ts"
